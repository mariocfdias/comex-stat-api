# =============================================================================
# comex-stat-api — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores antes de rodar.
# NUNCA commite o arquivo .env com valores reais.

# -----------------------------------------------------------------------------
# PostgreSQL (Data Warehouse)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=comexstat_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_pass

# Usuário da API (somente leitura no schema gold)
API_READER_PASSWORD=api_reader_pass

# Usuário do dbt (leitura/escrita em raw, staging, gold)
DBT_USER_PASSWORD=dbt_user_pass

# URL de conexão para o Airflow (banco exclusivo do Airflow)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow

# URL de conexão para a FastAPI (aponta para schema gold)
DATABASE_URL=postgresql+asyncpg://api_reader:api_reader_pass@postgres:5432/comexstat_platform

# -----------------------------------------------------------------------------
# MinIO (Data Lake — S3-compatible)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# Buckets
MINIO_BUCKET_RAW=raw-data
MINIO_BUCKET_STAGING=staging-data
MINIO_BUCKET_BACKUPS=backups

# -----------------------------------------------------------------------------
# Apache Airflow
# -----------------------------------------------------------------------------
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=comexstat-secret-key-change-in-production
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=True
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# FastAPI
# -----------------------------------------------------------------------------
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_RELOAD=true
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# NestJS (API original — não modificar)
# -----------------------------------------------------------------------------
# REDIS_URL=redis://redis:6379
# SELF_PING_URL=http://localhost:3000/health
